# =============================================
# 本地开发联调规则（示例）
# =============================================
@name "本地开发"
@priority 100

# --- MITM 拦截域名 ---
@intercept api.example.com

# --- Hosts 映射 ---
# 将 api.example.com 指向本地
127.0.0.1 api.example.com

# --- 正则 URL 代理 ---
# 前端 JS/CSS 代理到本地 webpack-dev-server
/\/static\/(app[\w-]*)\.js$/  http://127.0.0.1:3000/$1.js

# Webpack HMR 流式代理
/\/__webpack_hmr$/  http://127.0.0.1:3000/__webpack_hmr  @stream

# API 请求代理到本地后端（带 CORS）
/\/api\/v1\//  http://127.0.0.1:3000/api/v1/  @cors
